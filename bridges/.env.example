# ──────────────────────────────────────────────────────────────
# MyTok AI Bridge 환경변수
# 사용할 Bridge에 맞게 이 파일을 .env로 복사 후 채워넣으세요
# ──────────────────────────────────────────────────────────────

# ── 공통 ────────────────────────────────────────────────────
# MyTok UI에서 발급한 봇 토큰 (소유자 전용)
BOT_TOKEN=

# MyTok 서버 주소
MYTOK_URL=http://localhost:3500

# ── Hermes Bridge (bridge-hermes.js) ──────────────────────
# Hermes Agent API 서버가 실행 중이어야 합니다
# 설정: ~/.hermes/.env → API_SERVER_ENABLED=true, API_SERVER_KEY=your-secret
# 시작: hermes gateway  (포트 8642)
HERMES_BOT_TOKEN=           # Hermes 전용 봇 토큰 (없으면 BOT_TOKEN 사용)
HERMES_URL=http://localhost:8642
HERMES_API_KEY=             # ~/.hermes/.env 의 API_SERVER_KEY 값
HERMES_MODEL=hermes

# ── Claude Code Bridge (bridge-claude-code.js) ────────────
# Claude Code CLI가 설치되어 있어야 합니다
# 설치: https://docs.anthropic.com/claude-code
# 추가 설정 없음 — 시스템 PATH의 'claude' 명령을 사용합니다

# ── OpenClaw Bridge (bridge-openclaw.js) ──────────────────
# OpenClaw CLI가 설치되어 있어야 합니다 (npm install -g openclaw)
# openclaw gateway 서비스가 실행 중이어야 합니다
# openclaw agents list  ← 에이전트 ID 확인
OPENCLAW_BOT_TOKEN=         # OpenClaw 전용 봇 토큰 (없으면 BOT_TOKEN 사용)
OPENCLAW_BIN=openclaw       # PATH에 없으면 전체 경로 입력 (예: /usr/local/bin/openclaw)
OPENCLAW_AGENT=main
OPENCLAW_TIMEOUT_MS=120000
