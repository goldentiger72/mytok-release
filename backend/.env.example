# ──────────────────────────────────────────────────────────────
# MyTok Backend — 환경변수 설정
# 이 파일을 .env로 복사한 뒤 값을 채워넣으세요
# ──────────────────────────────────────────────────────────────

# ── Google OAuth 2.0 ─────────────────────────────────────────
# Google Cloud Console > APIs & Services > Credentials에서 발급
# 웹 애플리케이션 유형으로 OAuth 클라이언트 ID 생성
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── 세션 암호화 키 ──────────────────────────────────────────
# 무작위 32자 이상 문자열 (아래 명령으로 생성 가능):
# bun -e "const crypto = await import('crypto'); console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── 접근 허용 이메일 ────────────────────────────────────────
# 쉼표로 구분하여 로그인 허용할 이메일 목록
ALLOWED_EMAILS=user1@gmail.com,user2@gmail.com

# ── 소유자 이메일 ───────────────────────────────────────────
# 채팅방 생성·관리·봇 등록 권한을 가지는 관리자 이메일
OWNER_EMAIL=owner@gmail.com

# ── 서버 설정 ───────────────────────────────────────────────
PORT=3500

# 외부에서 접근하는 URL (OAuth 콜백에 사용)
# 예시:
#   Tailscale:          https://my-mac.tail12345.ts.net:3500
#   Cloudflare Tunnel:  https://chat.mydomain.com
#   로컬 개발:          http://localhost:3500
BASE_URL=http://localhost:3500

# ── 선택적 기능 ─────────────────────────────────────────────
# Intelligence Layer (Obsidian/Wiki/Ontology 연동)
# 사용하려면 true로 설정. 기본값: 비활성
# ENABLE_INTELLIGENCE_LAYER=true
